                            <Users size={10}/> Owners, Operators
                          </div>
                        </div>

                        {/* Box 4 */}
                        <div className="flex-1 bg-white border border-slate-200 p-4 rounded-xl shadow-sm relative pt-6 hover:border-blue-300 transition-colors">
                          <div className="absolute -top-6 left-1/2 w-px h-6 bg-slate-300"></div>
                          <div className="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-blue-100 text-blue-600 p-1.5 rounded-full"><FileCheck size={14}/></div>
                          <h5 className="font-bold text-sm text-slate-800 mb-2 leading-tight">Resource & Document Library</h5>
                          <p className="text-[11px] text-slate-500 mb-3">Forms, templates, and multilingual materials.</p>
                          <div className="flex items-center gap-1 text-[10px] text-blue-700 bg-blue-50 px-2 py-1 rounded inline-flex">
                            <Users size={10}/> All Audiences
                          </div>
                        </div>

                      </div>
                    </div>
                  </div>
                </div>
              )}

              {/* Karl Editorial Standards */}
              {activeTab === 'standards' && (
                <div className="p-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
                  <div className="flex items-center gap-3 mb-6">
                    <BookOpen className="text-blue-600" size={28} />
                    <div>
                      <h2 className="text-2xl font-black text-slate-800">Karl (SF.gov) Content Strategy</h2>
                      <p className="text-slate-500 text-sm">Transforming from information delivery to service delivery.</p>
                    </div>
                  </div>
                  
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
                    {/* Core Principles */}
                    <div>
                      <h3 className="text-lg font-bold text-slate-800 mb-4 border-b border-slate-200 pb-2">Core Service Principles</h3>
                      <ul className="space-y-4">
                        <li className="flex gap-3">
                          <CheckCircle size={18} className="text-emerald-500 flex-shrink-0 mt-0.5" />
                          <div>
                            <strong className="text-sm text-slate-800 block">Start with people & Make it easy</strong>
                            <p className="text-xs text-slate-600">Begin with what users need to do, not background info. Simplify complex processes.</p>
                          </div>
                        </li>
                        <li className="flex gap-3">
                          <CheckCircle size={18} className="text-emerald-500 flex-shrink-0 mt-0.5" />
                          <div>
                            <strong className="text-sm text-slate-800 block">Write in plain language</strong>
                            <p className="text-xs text-slate-600">Simple, clear, readable text at or below a 5th-grade reading level (8th-grade for specialists).</p>
                          </div>
                        </li>
                        <li className="flex gap-3">
                          <CheckCircle size={18} className="text-emerald-500 flex-shrink-0 mt-0.5" />
                          <div>
                            <strong className="text-sm text-slate-800 block">Task-first Structure</strong>
                            <p className="text-xs text-slate-600">Pages must begin with clear actions (e.g., reporting a problem, requesting a service).</p>
                          </div>
                        </li>
                        <li className="flex gap-3">
                          <CheckCircle size={18} className="text-emerald-500 flex-shrink-0 mt-0.5" />
                          <div>
                            <strong className="text-sm text-slate-800 block">Progressive Disclosure</strong>
                            <p className="text-xs text-slate-600">Top: immediate actions. Middle: practical guidance. Bottom: additional detail.</p>
                          </div>
                        </li>
                      </ul>
                    </div>

                    {/* Style Guide */}
                    <div>
                      <h3 className="text-lg font-bold text-slate-800 mb-4 border-b border-slate-200 pb-2">A-Z Style Guide Rules</h3>
                      <div className="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3">
                        <div className="bg-white p-3 rounded shadow-sm border border-slate-100">
                          <span className="text-[10px] font-bold text-blue-600 uppercase tracking-wider mb-1 block">Tone & Voice</span>
                          <p className="text-xs text-slate-700">Be direct and authoritative. Do not use "please" for requirements. Never use "Welcome to..."</p>
                        </div>
                        <div className="bg-white p-3 rounded shadow-sm border border-slate-100">
                          <span className="text-[10px] font-bold text-blue-600 uppercase tracking-wider mb-1 block">Formatting</span>
                          <p className="text-xs text-slate-700">Do not use ALL CAPS. Use bulleted lists restricted to 3–5 items max. Always use numbers (1-9 instead of one-nine).</p>
                        </div>
                        <div className="bg-white p-3 rounded shadow-sm border border-slate-100">
                          <span className="text-[10px] font-bold text-blue-600 uppercase tracking-wider mb-1 block">Links & Buttons</span>
                          <p className="text-xs text-slate-700">Link text must describe the destination (never "click here"). Buttons start with verbs.</p>
                        </div>
                        <div className="bg-white p-3 rounded shadow-sm border border-slate-100">
                          <span className="text-[10px] font-bold text-blue-600 uppercase tracking-wider mb-1 block">Language Restrictions</span>
                          <p className="text-xs text-slate-700">Avoid latin abbreviations (i.e., e.g., etc.). Spell out acronyms first. Avoid dashes.</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {/* Roadmap */}
              {activeTab === 'roadmap' && (
                <div className="p-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
                  <h2 className="text-2xl font-black text-slate-800 mb-8">Implementation Roadmap</h2>
                  <div className="max-w-2xl bg-white p-2">
                    <RoadmapPhase 
                      phase="1" 
                      title="Stabilize" 
                      timing="0-30 Days" 
                      tasks="Fix broken links, inconsistent titles, and duplicate labels. Remove years from resource titles." 
                    />
                    <RoadmapPhase 
                      phase="2" 
                      title="Rebuild Core" 
                      timing="30-60 Days" 
                      tasks="Rewrite vermin pages using the rodent pattern. Expand inspection explainer content." 
                    />
                    <RoadmapPhase 
                      phase="3" 
                      title="Curate Documents" 
                      timing="60-90 Days" 
                      tasks="Audit every file. Add one-sentence summaries, language labels, and 'reviewed' markers." 
                    />
                    <RoadmapPhase 
                      phase="4" 
                      title="Optimize" 
                      timing="90+ Days" 
                      tasks="Refine internal linking and SEO. Align labels to user intent and reduce self-competition." 
                    />
                  </div>
                </div>
              )}

              {/* Decision Points */}
              {activeTab === 'decisions' && (
                <div className="p-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
                  <h2 className="text-2xl font-black text-slate-800 mb-6">Leadership Decision Points</h2>
                  <div className="space-y-4 max-w-3xl">
                    {[
                      "Approve rodent page structure as the standard for all new guidance.",
                      "Approve consolidation toward task-based architecture vs. adding pages.",
                      "Approve content cleanup focused on broken labels and dead ends.",
                      "Approve development of a 'Reviewed/Current' tagging system for files.",
                      "Approve expansion of the Inspection Programs page for transparency."
                    ].map((text, index) => {
                      const isChecked = decisions[index];
                      return (
                        <label 
                          key={index} 
                          className={`flex items-center gap-4 p-5 border-2 rounded-xl cursor-pointer transition-all group shadow-sm ${isChecked ? 'border-blue-500 bg-blue-50/50' : 'border-slate-100 hover:border-blue-200 hover:bg-slate-50'}`}
                        >
                          <div className="flex-shrink-0">
                            <div className={`w-6 h-6 rounded border-2 flex items-center justify-center transition-colors ${isChecked ? 'border-blue-600 bg-blue-600' : 'border-slate-300 group-hover:border-blue-400'}`}>
                              <CheckCircle size={16} className={`text-white transition-all duration-300 ${isChecked ? 'opacity-100 scale-100' : 'opacity-0 scale-50 group-hover:opacity-50 group-hover:scale-100 group-hover:text-blue-400'}`} />
                            </div>
                          </div>
                          <input 
                            type="checkbox" 
                            className="sr-only" 
                            checked={!!isChecked} 
                            onChange={() => toggleDecision(index)}
                            aria-label={text}
                          />
                          <span className={`font-semibold transition-colors ${isChecked ? 'text-blue-900' : 'text-slate-700 group-hover:text-slate-900'}`}>{text}</span>
                        </label>
                      );
                    })}
                  </div>

                  {/* Progress Tracker */}
                  <div className="mt-8 p-4 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between max-w-3xl shadow-sm">
                    <span className="text-sm font-semibold text-slate-600">Approval Progress</span>
                    <span className="text-sm font-bold text-blue-600 bg-blue-100 px-3 py-1 rounded-full">
                      {Object.values(decisions).filter(Boolean).length} of 5 Complete
                    </span>
                  </div>
                </div>
              )}

              {/* Final Recommendation */}
              {activeTab === 'recommendation' && (
                <div className="p-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
                  <div className="flex items-center gap-3 mb-6">
                    <Flag className="text-emerald-600" size={28} />
                    <h2 className="text-2xl font-black text-slate-800">Final Recommendation</h2>
                  </div>

                  <div className="bg-emerald-50 border-l-4 border-emerald-500 p-6 md:p-8 rounded-r-xl mb-10 shadow-sm">
                    <p className="text-emerald-900 leading-relaxed text-lg mb-4">
                      The audit supports a <strong>consolidation strategy</strong> anchored by a repeatable public service page model. The proposed rodent redesign should be adopted as the gold standard for future Healthy Housing and Vector Control content because it demonstrates the correct balance of plain language, action sequencing, inspection transparency, and practical prevention guidance.
                    </p>
                    <p className="text-emerald-800 leading-relaxed">
                      A smaller task-based architecture, paired with a curated document library and consistent editorial standards, will improve usability for residents and create a more maintainable long-term content system for the program.
                    </p>
                  </div>

                  <h3 className="text-xl font-bold text-slate-800 mb-3">Standard Page Template</h3>
                  <p className="text-slate-600 mb-6 text-sm">All future Healthy Housing pages must follow this sequence to ensure consistent service delivery:</p>

                  <div className="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm mb-10">
                    <table className="w-full text-left border-collapse">
                      <thead>
                        <tr className="bg-slate-100 border-b border-slate-200">
                          <th className="p-4 font-bold text-sm text-slate-800 w-1/3">Section</th>
                          <th className="p-4 font-bold text-sm text-slate-800">Purpose</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-slate-100">
                        {[
                          { sec: "1. Title + problem statement", desc: "Tell the user exactly what issue this page solves" },
                          { sec: "2. What you can do now", desc: "Immediate steps in short bullets" },
                          { sec: "3. Signs or conditions to look for", desc: "Help users confirm they are in the right place" },
                          { sec: "4. How to prevent or fix the issue", desc: "Practical prevention and correction guidance" },
                          { sec: "5. Rights and responsibilities", desc: "Clarify owner, tenant, manager, or operator duties" },
                          { sec: "6. When to report or ask for help", desc: "Clear escalation guidance" },
                          { sec: "7. Contacts and links", desc: "Official phone, 3-1-1, forms, and related pages" }
                        ].map((row, i) => (
                          <tr key={i} className="hover:bg-slate-50 transition-colors">
                            <td className="p-4 text-sm font-bold text-slate-700">{row.sec}</td>
                            <td className="p-4 text-sm text-slate-600">{row.desc}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>

                  <div className="text-xs text-slate-500 border-t border-slate-200 pt-6">
                    <strong>Internal reference basis for this document:</strong> SF.gov Healthy Housing & Vector Control — Content Audit and Consolidation Report (v2), proposed rodent redesign text, and Karl SF.gov editorial model.
                  </div>
                </div>
              )}
            </div>

            {/* Editorial Standard Tip */}
            <div className="mt-6 flex items-start gap-3 p-5 bg-amber-50 rounded-xl border border-amber-200 shadow-sm">
              <Info className="text-amber-600 flex-shrink-0 mt-0.5" size={20}/>
              <div>
                <h4 className="text-sm font-bold text-amber-900 mb-1">Standard Page Template Sequence</h4>
                <p className="text-sm text-amber-800 leading-relaxed">
                  Every page must follow the sequence: <strong>Title → Problem → Action → Signs → Fix/Prevent → Responsibilities → Reporting.</strong> Do not mix service intake, regulatory explanation, and document dumping.
                </p>
              </div>
            </div>
          </div>
        </div>
      </main>

      <footer className="bg-slate-900 text-slate-400 py-12 mt-12 border-t-4 border-blue-600">
        <div className="max-w-6xl mx-auto px-6 text-center md:text-left flex flex-col md:flex-row justify-between items-center gap-8">
          <div>
            <h3 className="text-white font-bold mb-1 tracking-tight">San Francisco Department of Public Health</h3>
            <p className="text-sm">Healthy Housing & Vector Control Content Audit</p>
          </div>
          <div className="flex gap-4">
            <button className="text-sm font-medium border border-slate-600 px-5 py-2.5 rounded-lg hover:text-white hover:border-slate-400 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900">Download Full PDF</button>
            <button className="text-sm font-medium bg-blue-600 text-white px-5 py-2.5 rounded-lg hover:bg-blue-500 hover:shadow-lg hover:-translate-y-0.5 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900">Share Report</button>
          </div>
        </div>
      </footer>
    </div>
  );
};

export default App;
